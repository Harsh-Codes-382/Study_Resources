# Copy this file to `.env.local` and fill in a real value.
# `.env.local` is git-ignored, so your password never lands in the repo.
#
# Password for the "Interview Prep" shelf gate (see src/lib/interviewGate.js).
# This is a SOFT gate for a personal resource: the value is bundled into the
# client at build time, so it only keeps the shelf out of casual view.
#
# Locally: set it in `.env.local`.
# Production: add the same variable in Vercel → Project → Settings →
#             Environment Variables, then redeploy.
VITE_INTERVIEW_PREP_PASSWORD=changeme
